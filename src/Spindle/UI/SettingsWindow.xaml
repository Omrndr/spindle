<Window x:Class="Spindle.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spindle" Width="560" Height="760" MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="{DynamicResource Ink}"
        AllowDrop="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#3A86FF"/>
    <SolidColorBrush x:Key="WindowBg" Color="#F4F4F5"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardEdge" Color="#E8E8EA"/>
    <SolidColorBrush x:Key="Ink" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="Muted" Color="#86868B"/>
    <SolidColorBrush x:Key="Track" Color="#DCDCE0"/>
    <SolidColorBrush x:Key="KeyBg" Color="#F7F7F8"/>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardEdge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="18,14"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- macOS tarzı anahtar -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <!-- CheckBox ve RadioButton yazıları pencerenin rengini kendiliğinden almaz (sistem siyahı kalır). -->
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0"/>
              <Border x:Name="Track" Grid.Column="1" Width="40" Height="24" CornerRadius="12" Background="{DynamicResource Track}">
                <Ellipse x:Name="Knob" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="2,0">
                  <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.25"/>
                  </Ellipse.Effect>
                </Ellipse>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Tuş seçici: klavye tuşu görünümlü radyo düğmeleri -->
    <Style x:Key="KeyChoice" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Key" MinWidth="58" Height="34" CornerRadius="8" Background="{DynamicResource KeyBg}"
                    BorderBrush="{DynamicResource CardEdge}" BorderThickness="1,1,1,3" Padding="10,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Key" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- İnce kaydırıcı: dolu kısım vurgu renginde, yuvarlak tutamak -->
    <Style x:Key="SliderFill" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Track x:Name="PART_Track" Height="22">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource SliderFill}" Background="{DynamicResource Accent}" Command="Slider.DecreaseLarge"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource SliderFill}" Background="{DynamicResource Track}" Command="Slider.IncreaseLarge"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White" Stroke="{DynamicResource CardEdge}" StrokeThickness="1">
                        <Ellipse.Effect>
                          <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.25"/>
                        </Ellipse.Effect>
                      </Ellipse>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsDragging" Value="True">
                          <Setter TargetName="Knob" Property="Width" Value="20"/>
                          <Setter TargetName="Knob" Property="Height" Value="20"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Pill" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="10" Background="{DynamicResource Accent}" Padding="16,8">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="26,22,26,12">

      <!-- Başlık -->
      <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
        <Image x:Name="Logo" Width="44" Height="44"/>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Spindle" FontSize="24" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
          <TextBlock Text="Sürükle, tuşa bas, bırak. Her şey bilgisayarında olur." Foreground="{DynamicResource Muted}"/>
          <TextBlock Margin="0,2,0,0">
            <Hyperlink x:Name="TourLink" Foreground="{DynamicResource Accent}" TextDecorations="{x:Null}">Nasıl kullanılır?</Hyperlink>
          </TextBlock>
        </StackPanel>
      </StackPanel>

      <!-- Deneme alanı -->
      <Border x:Name="DropZone" CornerRadius="16" BorderThickness="1.5" BorderBrush="{DynamicResource Track}"
              Background="{DynamicResource CardBg}" Padding="18" Margin="0,0,0,14" Cursor="Hand">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="&#xE8B5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26"
                     HorizontalAlignment="Center" Foreground="{DynamicResource Accent}"/>
          <TextBlock Text="Bir dosyayı buraya bırakın ya da tıklayıp seçin" HorizontalAlignment="Center"
                     FontWeight="SemiBold" Margin="0,8,0,2"/>
          <TextBlock x:Name="HowTo" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                     Foreground="{DynamicResource Muted}"/>
        </StackPanel>
      </Border>

      <!-- Kısayollar -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="KISAYOLLAR" Style="{StaticResource CardTitle}"/>
          <TextBlock Text="Dönüştürme çarkı" Margin="0,2,0,6"/>
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="ConvertShift" GroupName="convert" Content="⇧ Shift" Style="{StaticResource KeyChoice}"/>
            <RadioButton x:Name="ConvertCtrl" GroupName="convert" Content="Ctrl" Style="{StaticResource KeyChoice}"/>
            <RadioButton x:Name="ConvertAlt" GroupName="convert" Content="Alt" Style="{StaticResource KeyChoice}"/>
          </StackPanel>
          <TextBlock Text="Araçlar çarkı (sıkıştır, döndür, metadata sil…)" Margin="0,14,0,6"/>
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="ToolsShift" GroupName="tools" Content="⇧ Shift" Style="{StaticResource KeyChoice}"/>
            <RadioButton x:Name="ToolsCtrl" GroupName="tools" Content="Ctrl" Style="{StaticResource KeyChoice}"/>
            <RadioButton x:Name="ToolsAlt" GroupName="tools" Content="Alt" Style="{StaticResource KeyChoice}"/>
          </StackPanel>
          <TextBlock x:Name="KeyWarning" Foreground="#E5484D" Margin="0,8,0,0" Visibility="Collapsed"
                     Text="İki çark aynı tuşu kullanamaz."/>
        </StackPanel>
      </Border>

      <!-- Davranış -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="DAVRANIŞ" Style="{StaticResource CardTitle}"/>
          <CheckBox x:Name="Gesture" Style="{StaticResource Switch}">
            <StackPanel>
              <TextBlock Text="Sürüklerken tuşla çarkı aç"/>
              <TextBlock Text="Kapalıyken yalnızca sağ tık menüsü ve tepsi simgesi çalışır." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
          </CheckBox>
          <CheckBox x:Name="OnlyExplorer" Style="{StaticResource Switch}">
            <StackPanel>
              <TextBlock Text="Yalnızca Dosya Gezgini ve masaüstünde"/>
              <TextBlock Text="Başka uygulamalarda Shift ile sürüklerken çark açılmaz." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
          </CheckBox>
          <CheckBox x:Name="MenuSwitch" Style="{StaticResource Switch}">
            <StackPanel>
              <TextBlock Text="Sağ tık menüsünde göster"/>
              <TextBlock Text="Windows 11'de &quot;Diğer seçenekleri göster&quot; altında görünür." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
          </CheckBox>
          <CheckBox x:Name="Autostart" Style="{StaticResource Switch}">
            <TextBlock Text="Windows açılınca arka planda başlat"/>
          </CheckBox>
          <CheckBox x:Name="SoundSwitch" Style="{StaticResource Switch}">
            <StackPanel>
              <TextBlock Text="Sesler"/>
              <TextBlock Text="Tuşlar arasında kısa bir tık, işler bitince yumuşak bir çan." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
          </CheckBox>
        </StackPanel>
      </Border>

      <!-- Kalite -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="KALİTE" Style="{StaticResource CardTitle}"/>
          <DockPanel>
            <TextBlock x:Name="QualityLabel" DockPanel.Dock="Right" Width="44" TextAlignment="Right" FontWeight="SemiBold"/>
            <TextBlock Text="JPG / WebP / AVIF kalitesi" VerticalAlignment="Center"/>
          </DockPanel>
          <Slider x:Name="Quality" Minimum="50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>

      <!-- Motorlar -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="DÖNÜŞTÜRME MOTORLARI" Style="{StaticResource CardTitle}"/>
          <DockPanel Margin="0,4">
            <TextBlock x:Name="OfficeState" DockPanel.Dock="Right" FontWeight="SemiBold"/>
            <TextBlock Text="Microsoft Office (Word, Excel, PowerPoint)"/>
          </DockPanel>
          <DockPanel Margin="0,4">
            <TextBlock x:Name="FfmpegState" DockPanel.Dock="Right" FontWeight="SemiBold"/>
            <TextBlock Text="ffmpeg (ses ve video)"/>
          </DockPanel>
          <TextBlock x:Name="FfmpegPathText" Foreground="{DynamicResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
          <Button x:Name="InstallFfmpeg" Style="{StaticResource Pill}" Content="ffmpeg'i kur (winget)" HorizontalAlignment="Left"
                  Margin="0,10,0,0" Visibility="Collapsed"/>
          <TextBlock Text="Görseller, PDF sayfaları ve arşivler ek bir şey gerektirmez." Foreground="{DynamicResource Muted}"
                     FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <TextBlock Text="Spindle pencereyi kapatınca da sistem tepsisinde çalışmaya devam eder."
                 Foreground="{DynamicResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,8"/>
    </StackPanel>
  </ScrollViewer>
</Window>
