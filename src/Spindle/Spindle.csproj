<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Magick.NET'in yerel kütüphanesi uygulamanın yanına kopyalansın (aksi halde runtimes\ altında kalıp yüklenemiyor). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Tepside bekleyen bir uygulama için arka plan GC iş parçacığı gereksiz; belleği de azaltır. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Yalnızca sistem tepsisi simgesi (NotifyIcon) için -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\spindle.ico</ApplicationIcon>
    <AssemblyTitle>Spindle</AssemblyTitle>
    <Product>Spindle</Product>
    <Version>0.1.2</Version>
    <!-- WFO0003: DPI ayarı manifestte; WPF uygulaması için doğru yer orası. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\spindle.ico" />
    <!-- Tanıtım GIF'leri README'dekilerle aynı dosyalardır (docs klasörü). -->
    <Resource Include="..\..\docs\tanitim-*.gif" Link="Tour\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spindle.Core\Spindle.Core.csproj" />
  </ItemGroup>

</Project>
